# Godot 4+ specific ignores
.godot/
/android/

# Build output - the GitHub Actions workflow rebuilds these
/build/
/dist/
/web/play/

# Secrets: never public (tools/auto_push.ps1 also refuses these)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# Operating system files
.DS_Store
Thumbs.db

# Claude Code: worktrees and personal settings stay local
.claude/worktrees/
.claude/settings.local.json
