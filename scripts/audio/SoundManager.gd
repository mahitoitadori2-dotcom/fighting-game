extends Node
## SOUND MANAGER (Autoload "SoundManager"). Every sound in the game goes through here.
##
##   SoundManager.play_sfx("punch")            one-shot sound effect
##   SoundManager.play_music("fight")          looping music (same track = keeps playing)
##   SoundManager.stop_music()
##   SoundManager.set_volume("music", 0.8)     "music" / "sfx" / "master", 0.0 - 1.0
##   SoundManager.set_muted(true) / toggle_mute()
##
## FILES (drop them in, nothing is hard-coded to a format):
##   res://audio/sfx/<name>.ogg / .wav / .mp3
##   res://audio/music/<name>.ogg / .mp3 / .wav       (menu, fight, boss)
## A missing file is simply silent (never crashes). Placeholder .wav files are
## generated by tools/make_placeholder_audio.js.
##
## BUSES: "Music" and "SFX" are created at startup (both feed Master), so the
## volume sliders are just bus volumes. Settings are saved to user://audio.cfg
## (works on Web too: stored in the browser).
##
## WEB / iPhone: browsers block audio until the first tap. The web page's
## "Tap to Start" button is that tap, so music can start right away; anything
## requested before the unlock simply starts once the browser allows audio.
##
## LOW HP: during "fight" / "boss*" music the track speeds up (pitch_scale) when
## YOUR fighter is below LOW_HP_RATIO.
##
## VOICE LINES:  SoundManager.say("minos_intro", "I am King Minos!", 0.55, 0.9)
##   1. res://audio/voice/<key>.ogg / .wav / .mp3 exists -> that recording plays
##   2. otherwise the system TEXT-TO-SPEECH voice reads the line (Windows, Web, iPhone),
##      pitched down for the bosses. No voice available = silent (the line is still
##      shown on screen by the boss).

const SFX_DIR := "res://audio/sfx/"
const VOICE_DIR := "res://audio/voice/"
const MUSIC_DIR := "res://audio/music/"
const SFX_EXTS := ["ogg", "wav", "mp3"]
const MUSIC_EXTS := ["ogg", "mp3", "wav"]
const SFX_VOICES := 16                  # Simultaneous sound effects (players are reused)
const SAME_SFX_GAP_MS := 45             # The same sound can't stack more often than this
const CROSSFADE := 0.6
const LOW_HP_RATIO := 0.3
const LOW_HP_PITCH := 1.12              # Fight music tempo when you're almost dead
const SETTINGS_PATH := "user://audio.cfg"

## Old / per-move sound names -> the file that plays. Lets gameplay code use
## descriptive names while you only need the files listed in AUDIO_FILES.txt.
const ALIASES := {
	"hit_tick": "", "hit_heavy": "hit", "hit_ultimate": "hit", "block_perfect": "block",
	"rotor_bark": "bark", "rotor_bark_windup": "", "rotor_enraged": "",
	"frog_croak": "croak", "frog_tongue": "dash", "trex_laser": "laser",
	"angel_beam": "beam", "rocket_dash": "dash", "piano_crash": "explosion",
}

## Move id (ControlledFighter.move_ids) -> sound when it is cast.
const MOVE_SFX := {
	"drill": "drill",                    # Architect: Armaggedon Drill
	"grab": "void_goo", "eternal": "void_goo",   # Warrior: void moves
	"flame": "flame", "bat": "flame", "spikes": "flame",   # Nightmare (Fire) Lord
	"beam": "beam",                      # Enlightened One: Beam Blast
	"heal": "heal",
}

var music_volume := 0.8
var sfx_volume := 0.9
var muted := false

var _music_bus := -1
var _sfx_bus := -1
var _voices: Array[AudioStreamPlayer] = []
var _next_voice := 0
var _cache := {}                        # path key -> AudioStream (or null = missing)
var _last_played := {}                  # sfx name -> msec
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_name := ""
var _music_tween: Tween
var _fades := {}                        # AudioStreamPlayer -> its fade-out Tween
var _target_pitch := 1.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS          # Keeps working during pause / hitstop
	_music_bus = _ensure_bus("Music")
	_sfx_bus = _ensure_bus("SFX")
	for i in SFX_VOICES:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_voices.append(p)
	_music_a = _make_music_player()
	_music_b = _make_music_player()
	_load_settings()
	_apply_volumes()
	# Low-HP tempo check 4x per second (not every frame)
	var t := Timer.new()
	t.wait_time = 0.25
	t.autostart = true
	t.timeout.connect(_check_low_hp)
	add_child(t)
	set_process(false)


# ============================================================
# SFX
# ============================================================
func play_sfx(sfx_name: String, volume_db: float = 0.0, pitch_jitter: float = 0.06) -> void:
	sfx_name = ALIASES.get(sfx_name, sfx_name)
	if sfx_name == "":
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(sfx_name, -1000)) < SAME_SFX_GAP_MS:
		return                                          # 20 projectiles hitting at once = one sound
	var stream := _load(SFX_DIR, sfx_name, SFX_EXTS)
	if stream == null:
		return                                          # Missing file: silent, never a crash
	_last_played[sfx_name] = now
	var p := _voices[_next_voice]
	_next_voice = (_next_voice + 1) % _voices.size()
	p.stop()
	p.stream = stream
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


var _voice_player: AudioStreamPlayer
var _tts_voice := ""
var _tts_checked := false


## Boss voice line. key = optional recording in res://audio/voice/, text = what is said
## (TTS fallback). pitch / rate: 1.0 = normal; bosses use a low pitch.
func say(key: String, text: String, pitch: float = 0.6, rate: float = 0.95) -> void:
	if muted or sfx_volume <= 0.001:
		return
	var stream := _load(VOICE_DIR, key, SFX_EXTS) if key != "" else null
	if stream != null:
		if _voice_player == null:
			_voice_player = AudioStreamPlayer.new()
			_voice_player.bus = "SFX"
			add_child(_voice_player)
		_voice_player.stop()
		_voice_player.stream = stream
		_voice_player.volume_db = 2.0
		_voice_player.play()
		return
	var voice := _tts()
	if voice == "":
		return
	DisplayServer.tts_stop()                            # A new line cuts the old one
	DisplayServer.tts_speak(text, voice, clampi(roundi(sfx_volume * 100.0), 0, 100), pitch, rate)


func stop_voice() -> void:
	if _voice_player != null:
		_voice_player.stop()
	if _tts() != "":
		DisplayServer.tts_stop()


## First English TTS voice ("" = no TTS on this device / setting off).
func _tts() -> String:
	if _tts_checked:
		return _tts_voice
	_tts_checked = true
	if not ProjectSettings.get_setting("audio/general/text_to_speech", false):
		return ""
	var voices := DisplayServer.tts_get_voices_for_language("en")
	if voices.is_empty():
		var all := DisplayServer.tts_get_voices()
		if not all.is_empty():
			_tts_voice = String(all[0].get("id", ""))
	else:
		_tts_voice = voices[0]
		for v in DisplayServer.tts_get_voices():               # Prefer a male voice: deeper bosses
			var nm := String(v.get("name", "")).to_lower()
			var male := nm.contains("david") or nm.contains("daniel") or nm.contains("george") \
				or (nm.contains("male") and not nm.contains("female"))
			if String(v.get("language", "")).begins_with("en") and male:
				_tts_voice = String(v.get("id", _tts_voice))
				break
	return _tts_voice


## Sound for a cast move id ("drill", "eternal", "flame", "beam"...). Unknown ids are silent.
func play_move_sfx(move_id: String) -> void:
	var s: String = MOVE_SFX.get(move_id, "")
	if s != "":
		play_sfx(s)


# ============================================================
# MUSIC
# ============================================================
## Starts a looping track (crossfade). Asking for the track that is already playing does nothing.
func play_music(music_name: String) -> void:
	if music_name == _music_name and _current_music().playing:
		return
	_music_name = music_name
	_target_pitch = 1.0
	var stream := _load(MUSIC_DIR, music_name, MUSIC_EXTS)
	var old := _current_music()
	var nxt := _music_b if old == _music_a else _music_a
	if _music_tween != null:
		_music_tween.kill()
	_fade_out(old)
	if stream == null:
		return                                          # Missing track: just fade out the old one
	_set_loop(stream)
	if _fades.has(nxt):
		(_fades[nxt] as Tween).kill()                   # Don't let an old fade-out stop the new track
		_fades.erase(nxt)
	nxt.stream = stream
	nxt.pitch_scale = 1.0
	nxt.volume_db = -40.0
	nxt.play()
	_music_tween = create_tween()
	_music_tween.tween_property(nxt, "volume_db", 0.0, CROSSFADE)
	_active_music = nxt


func stop_music() -> void:
	_music_name = ""
	if _music_tween != null:
		_music_tween.kill()
	_fade_out(_music_a)
	_fade_out(_music_b)


func _fade_out(p: AudioStreamPlayer) -> void:
	if not p.playing:
		return
	if _fades.has(p):
		(_fades[p] as Tween).kill()
	var tw := create_tween()
	tw.tween_property(p, "volume_db", -40.0, CROSSFADE)
	tw.tween_callback(p.stop)
	_fades[p] = tw


func current_music() -> String:
	return _music_name


var _active_music: AudioStreamPlayer


func _current_music() -> AudioStreamPlayer:
	return _active_music if _active_music != null else _music_a


func _make_music_player() -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = "Music"
	add_child(p)
	return p


func _set_loop(stream: AudioStream) -> void:
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	elif stream is AudioStreamMP3:
		(stream as AudioStreamMP3).loop = true
	elif stream is AudioStreamWAV:
		var w := stream as AudioStreamWAV
		if w.loop_mode == AudioStreamWAV.LOOP_DISABLED:
			w.loop_mode = AudioStreamWAV.LOOP_FORWARD
			w.loop_begin = 0
			w.loop_end = int(w.get_length() * w.mix_rate)


## Fight music speeds up when YOUR fighter (slot 1) is low on HP.
func _check_low_hp() -> void:
	if _music_name != "fight" and not _music_name.begins_with("boss"):
		_target_pitch = 1.0
	else:
		var low := false
		for n in get_tree().get_nodes_in_group("fighters"):
			var f := n as Fighter
			if f != null and f.slot == 1 and not f.is_dead and f.data != null:
				low = float(f.hp) / maxf(float(f.data.max_hp), 1.0) <= LOW_HP_RATIO
		_target_pitch = LOW_HP_PITCH if low else 1.0
	set_process(not is_equal_approx(_current_music().pitch_scale, _target_pitch))


func _process(delta: float) -> void:
	var p := _current_music()
	p.pitch_scale = move_toward(p.pitch_scale, _target_pitch, delta * 0.25)   # Smooth tempo ramp
	if is_equal_approx(p.pitch_scale, _target_pitch):
		set_process(false)


# ============================================================
# VOLUME / MUTE (+ saved settings)
# ============================================================
## which = "music", "sfx" or "master"; value 0.0 - 1.0
func set_volume(which: String, value: float) -> void:
	value = clampf(value, 0.0, 1.0)
	match which:
		"music":
			music_volume = value
		"sfx":
			sfx_volume = value
		"master":
			AudioServer.set_bus_volume_db(0, linear_to_db(maxf(value, 0.0001)))
	_apply_volumes()
	_save_settings()


func get_volume(which: String) -> float:
	match which:
		"music":
			return music_volume
		"sfx":
			return sfx_volume
	return db_to_linear(AudioServer.get_bus_volume_db(0))


func set_muted(on: bool) -> void:
	muted = on
	_apply_volumes()
	_save_settings()


func toggle_mute() -> void:
	set_muted(not muted)


func _apply_volumes() -> void:
	AudioServer.set_bus_mute(0, muted)
	AudioServer.set_bus_volume_db(_music_bus, linear_to_db(maxf(music_volume, 0.0001)))
	AudioServer.set_bus_mute(_music_bus, music_volume <= 0.001)
	AudioServer.set_bus_volume_db(_sfx_bus, linear_to_db(maxf(sfx_volume, 0.0001)))
	AudioServer.set_bus_mute(_sfx_bus, sfx_volume <= 0.001)


func _load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) != OK:
		return
	music_volume = float(cfg.get_value("audio", "music", music_volume))
	sfx_volume = float(cfg.get_value("audio", "sfx", sfx_volume))
	muted = bool(cfg.get_value("audio", "muted", muted))


func _save_settings() -> void:
	var cfg := ConfigFile.new()
	cfg.set_value("audio", "music", music_volume)
	cfg.set_value("audio", "sfx", sfx_volume)
	cfg.set_value("audio", "muted", muted)
	cfg.save(SETTINGS_PATH)


# ============================================================
# LOADING
# ============================================================
func _ensure_bus(bus_name: String) -> int:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, "Master")
	return idx


## First existing file wins (<dir><name>.<ext>). Cached, including "missing".
func _load(dir: String, file_name: String, exts: Array) -> AudioStream:
	var key := dir + file_name
	if _cache.has(key):
		return _cache[key]
	var stream: AudioStream = null
	for ext in exts:
		var path := "%s%s.%s" % [dir, file_name, ext]
		if ResourceLoader.exists(path):
			stream = load(path) as AudioStream
			if stream != null:
				break
	_cache[key] = stream
	return stream
